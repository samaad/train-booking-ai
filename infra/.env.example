# Copy to infra/.env (gitignored) to override defaults. Compose reads it automatically.
# Host ports — change if something else on this machine already binds them.
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=admin
