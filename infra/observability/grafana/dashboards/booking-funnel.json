{
 "uid": "booking-funnel",
 "title": "Booking Funnel",
 "description": "Where travellers drop out, and where trains are oversubscribed.",
 "tags": [
  "train-booking"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Funnel (per minute)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (stage) (rate(booking_funnel_total[5m])) * 60",
     "legendFormat": "{{stage}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "search \u2192 hold \u2192 book \u2192 pay \u2192 confirm"
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Search \u2192 confirm conversion (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(booking_funnel_total{stage=\"confirm\"}[1h])) / clamp_min(sum(increase(booking_funnel_total{stage=\"search\"}[1h])), 1)",
     "legendFormat": "conversion",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Hold \u2192 pay conversion (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(booking_funnel_total{stage=\"pay\"}[1h])) / clamp_min(sum(increase(booking_funnel_total{stage=\"hold\"}[1h])), 1)",
     "legendFormat": "conversion",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Hold expiry ratio (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(seat_hold_expired_total[1h])) / clamp_min(sum(increase(seat_hold_placed_total[1h])), 1)",
     "legendFormat": "expired / placed",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {},
   "description": "Squatting / abandoned carts; tune the hold TTL."
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Seat contention by train",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (train) (rate(seat_hold_contention_total[5m]))",
     "legendFormat": "{{train}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {},
   "description": "Lost races for a seat = oversubscribed train. Capacity signal."
  }
 ]
}