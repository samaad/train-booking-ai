{
 "uid": "saga-outbox",
 "title": "Saga / Outbox Health",
 "description": "Choreographed saga health: outbox delivery, compensations, dead letters.",
 "tags": [
  "train-booking"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Outbox lag (oldest unpublished event)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (application) (outbox_lag_seconds)",
     "legendFormat": "{{application}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "description": "Page on this: events are committed but not reaching Kafka."
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Compensations",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (increase(saga_compensation_total[15m]))",
     "legendFormat": "{{type}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Every one is a near-miss worth reviewing."
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Dead-lettered events",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic, group) (increase(kafka_dead_letter_total[15m]))",
     "legendFormat": "{{topic}} \u2192 {{group}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "description": "Each needs manual follow-up (DLT)."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Total dead letters (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(kafka_dead_letter_total[24h]))",
     "legendFormat": "dead letters",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Outbox lag now (max)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(outbox_lag_seconds)",
     "legendFormat": "lag",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}